      ],
      "required_fields": [
        "@timestamp",
        "event.category",
        "event.action",
        "host.name"
      ]
    },
    "aws.cloudtrail": {
      "description": "AWS CloudTrail ECS (원본 JSON 변환 필요)",
      "index_prefix": "logs-aws.cloudtrail-lab",
      "dataset": "aws.cloudtrail",
      "rule_index_patterns": [
        "logs-aws.cloudtrail-*"
      ],
      "required_fields": [
        "@timestamp",
        "event.provider",
        "event.action",
        "event.outcome"
      ]
    }
  }
}
