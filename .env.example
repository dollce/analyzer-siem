# `python3 builder.py init` creates .env with random secrets.
COMPOSE_PROJECT_NAME=elastic-siem-lab
STACK_VERSION=9.5.5
# Optional eligible Trial activation: set trial or use `builder.py up --trial`.
LICENSE_MODE=basic
BIND_HOST=0.0.0.0
ES_PORT=9200
ES_TRANSPORT_PORT=9300
KIBANA_PORT=5601
BEATS_PORT=5044
SYSLOG_PORT=5514
ES_MEMORY=3g
ES_JAVA_OPTS=-Xms1g -Xmx1g
KIBANA_MEMORY=2g
LOGSTASH_MEMORY=2g
LS_JAVA_OPTS=-Xms512m -Xmx512m
ELASTIC_PASSWORD=GENERATE
KIBANA_PASSWORD=GENERATE
LOGSTASH_PASSWORD=GENERATE
KIBANA_ENCRYPTION_KEY=GENERATE
KIBANA_REPORTING_KEY=GENERATE
KIBANA_SECURITY_KEY=GENERATE
PREBUILT_RULES=true
# Add LAN IPs/DNS names before first up, comma separated, for HTTPS verification.
TLS_EXTRA_IPS=
TLS_EXTRA_DNS=
